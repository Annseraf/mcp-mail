# claude-mail-mcp v0.2 — only transport-level config lives here.
# Mailbox credentials (IMAP, SMTP, CalDAV) are stored in accounts.json
# and managed via the OAuth shim's /settings UI.

# --- Server ---
# Interface to bind on. Default 127.0.0.1 (loopback only). nginx/Caddy
# terminates TLS upstream. Set to 0.0.0.0 only if you really want this
# process directly internet-reachable.
HOST=127.0.0.1
PORT=3220
PUBLIC_URL=https://mcp-mail.example.com
# debug | info | warn | error
LOG_LEVEL=info

# --- Authentication ---
# Bearer token clients must send in `Authorization: Bearer <token>` to call /mcp.
# In production: the OAuth shim injects this on behalf of the user after
# verifying their OAuth token. The shim reads the SAME token from
# UPSTREAM_BEARER_FILE — keep both in sync.
# Generate with: openssl rand -hex 32
AUTH_TOKEN=

# --- Accounts ---
# Path to the multi-account credentials file. The OAuth shim writes here
# when you add/edit an account via the /settings UI. The backend re-reads
# the file via fs.watch, so changes apply without a restart.
#
# Default suits a single-host deployment with the OAuth shim. For local
# development, point this somewhere in your home directory.
ACCOUNTS_FILE=/root/.config/mail-mcp/accounts.json

# --- Optional: encryption at rest for accounts.json (docs/PLATFORM.md) ---
# SECRETS_ENCRYPTION=local
# SECRETS_KEY_FILE=/etc/mcp-mail/keys/kek

# --- Optional: platform mode (docs/PLATFORM.md). Off unless set. ---
# MULTI_TENANT=true
# DATA_DIR=/var/lib/mcp-mail
# TENANT_BASE_URL=https://connect.example.com
# ADMIN_API=true
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=3330
# ADMIN_TOKEN_FILE=/etc/mcp-mail/admin-token

# --- Optional: per-client identities, OAuth and audit (docs/CLIENTS.md) ---
# CLIENTS_FILE=/var/lib/mail-mcp/clients.json
# OAUTH=true
# TOKEN_SECRET_FILE=/etc/mcp-mail/token-secret
# LOGIN_USER=you
# LOGIN_PASSWORD_HASH=scrypt:...
# AUDIT_LOG=/var/log/mcp-mail/audit.jsonl

# --- Optional: mail tool behavior ---
# UNTRUSTED_FENCING=false          # default on: wrap email content in untrusted delimiters
# ATTACHMENT_MAX_BYTES=20971520    # per download and per outgoing message (requests are also capped at 5 MB)
# ACCOUNT_SETTINGS_FILE=/var/lib/mail-mcp/account-settings.json  # sender names/signatures set by agents
