{
  "name": "@annseraf/mcp-mail",
  "version": "1.0.2",
  "description": "Self-hosted IMAP/SMTP email MCP server for Claude, ChatGPT, Cursor and any MCP client, with per-client permissions, audit log and one-line install.",
  "license": "MIT",
  "author": "Mohith K Das",
  "homepage": "https://github.com/Annseraf/mcp-mail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Annseraf/mcp-mail.git"
  },
  "bugs": {
    "url": "https://github.com/Annseraf/mcp-mail/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "email",
    "imap",
    "smtp",
    "caldav",
    "claude",
    "chatgpt",
    "cursor",
    "ai-agents",
    "self-hosted",
    "oauth2",
    "purelymail",
    "fastmail",
    "icloud",
    "gmail",
    "email-assistant",
    "llm",
    "multi-tenant"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-mail": "dist/index.js",
    "claude-mail-mcp": "dist/index.js"
  },
  "files": [
    ".env.example",
    "LICENSE",
    "README.md",
    "compat/baseline",
    "dist",
    "docs",
    "install.sh",
    "llms.txt",
    "openapi",
    "packaging"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-info.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "licenses": "node scripts/check-licenses.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run licenses && npm run build",
    "test:compat": "npm run build && COMPAT_GATE=1 vitest run",
    "compat:baseline": "tsx scripts/compat-baseline.ts",
    "openapi": "node scripts/gen-openapi.mjs && prettier --write openapi/admin-v1.json",
    "docs": "node scripts/gen-llms-full.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.0.1",
    "html-to-text": "^10.0.1",
    "ical.js": "^2.1.0",
    "imapflow": "^1.0.180",
    "mailparser": "^3.7.2",
    "nodemailer": "^10.3.1",
    "tsdav": "^2.1.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "contributors": [
    "Markus Stöger <hi@markusstoeger.com> (https://markusstoeger.com) — original claude-mail-mcp"
  ],
  "mcpName": "io.github.Annseraf/mcp-mail",
  "publishConfig": {
    "access": "public"
  }
}
