          }
        }
      ],
      "get": {
        "operationId": "listAudit",
        "summary": "Read the audit log, newest first",
        "parameters": [
          {
            "name": "client",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ObjectId"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid service token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Tenant not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/tenants/{tenantId}/usage": {
      "parameters": [
        {
          "name": "tenantId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
          }
        }
      ],
      "get": {
        "operationId": "getUsage",
        "summary": "Tool calls per day, per client (last 35 days)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid service token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Tenant not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "ADMIN_TOKEN"
      }
    },
    "schemas": {
      "ObjectId": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
      },
      "Error": {
        "type": "object",
        "required": ["error", "message"],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "Version": {
        "type": "object",
        "required": ["name", "version", "commit", "buildTime", "imageDigest"],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "buildTime": {
            "type": ["string", "null"]
          },
          "imageDigest": {
            "type": ["string", "null"]
          }
        }
      },
      "Limits": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "maxMailboxes",
          "maxClients",
          "toolCallsPerDay",
          "allowSend",
          "maxRecipientsPerSend",
          "auditRetentionDays"
        ],
        "properties": {
          "maxMailboxes": {
            "type": "integer",
            "minimum": 0
          },
          "maxClients": {
            "type": "integer",
            "minimum": 0
          },
          "toolCallsPerDay": {
            "type": "integer",
            "minimum": 0
          },
          "allowSend": {
            "type": "boolean"
          },
          "maxRecipientsPerSend": {
            "type": "integer",
            "minimum": 1
          },
          "auditRetentionDays": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "LimitsPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxMailboxes": {
            "type": "integer",
            "minimum": 0
          },
          "maxClients": {
            "type": "integer",
            "minimum": 0
          },
          "toolCallsPerDay": {
            "type": "integer",
            "minimum": 0
          },
          "allowSend": {
            "type": "boolean"
          },
          "maxRecipientsPerSend": {
            "type": "integer",
            "minimum": 1
          },
          "auditRetentionDays": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "TenantCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
          },
          "limits": {
            "$ref": "#/components/schemas/LimitsPatch"
          }
        }
      },
      "Tenant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "createdAt",
          "updatedAt",
          "revision",
          "limits",
          "mailboxes",
          "clients"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": ["active", "suspended"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "integer"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "mailboxes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Mailbox"
            }
          },
          "clients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Client"
            }
          }
        }
      },
      "Endpoint": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "port", "tls", "user"],
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "tls": {
            "type": "boolean",
            "description": "true = implicit TLS (993/465); false = plain or STARTTLS"
          },
          "user": {
            "type": "string"
          }
        }
      },
      "EndpointWithPassword": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "port", "tls", "user", "password"],
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "tls": {
            "type": "boolean",
            "description": "true = implicit TLS (993/465); false = plain or STARTTLS"
          },
          "user": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "MailDefaults": {
        "type": "object",
        "additionalProperties": false,
        "required": ["defaultFrom"],
        "properties": {
          "defaultFrom": {
            "type": "string"
          },
          "defaultFromName": {
            "type": ["string", "null"]
          },
          "signature": {
            "type": ["string", "null"],
            "description": "Appended to sent mail and drafts"
          },
          "draftsFolder": {
            "type": "string",
            "default": "Drafts"
          },
          "sentFolder": {
            "type": ["string", "null"],
            "default": "Sent"
          }
        }
      },
      "Mailbox": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "default",
          "status",
          "imap",
          "smtp",
          "mail",
          "caldav",
          "createdAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "label": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "status": {
            "enum": ["active", "suspended"]
          },
          "imap": {
            "$ref": "#/components/schemas/Endpoint"
          },
          "smtp": {
            "$ref": "#/components/schemas/Endpoint"
          },
          "mail": {
            "$ref": "#/components/schemas/MailDefaults"
          },
          "caldav": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["url", "user"],
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "user": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MailboxCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "imap", "smtp", "mail"],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "default": {
            "type": "boolean"
          },
          "imap": {
            "$ref": "#/components/schemas/EndpointWithPassword"
          },
          "smtp": {
            "$ref": "#/components/schemas/EndpointWithPassword"
          },
          "mail": {
            "$ref": "#/components/schemas/MailDefaults"
          },
          "caldav": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "user", "password"],
            "properties": {
              "url": {
                "type": "string"
              },
              "user": {
                "type": "string"
              },
              "password": {
                "type": "string",
                "writeOnly": true
              }
            }
          }
        }
      },
      "MailboxPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "status": {
            "enum": ["active", "suspended"]
          },
          "imap": {
            "type": "object",
            "description": "Any subset of EndpointWithPassword"
          },
          "smtp": {
            "type": "object",
            "description": "Any subset of EndpointWithPassword"
          },
          "mail": {
            "type": "object",
            "description": "Any subset of MailDefaults"
          },
          "caldav": {
            "description": "Replace (object with password) or remove (null)"
          }
        }
      },
      "MailboxTest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["imap", "smtp"],
        "properties": {
          "imap": {
            "$ref": "#/components/schemas/EndpointWithPassword"
          },
          "smtp": {
            "$ref": "#/components/schemas/EndpointWithPassword"
          }
        }
      },
      "CheckResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok"],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "MailboxTestResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["imap", "smtp"],
        "properties": {
          "imap": {
            "$ref": "#/components/schemas/CheckResult"
          },
          "smtp": {
            "$ref": "#/components/schemas/CheckResult"
          }
        }
      },
      "Preset": {
        "enum": ["read-only", "read-draft", "organize", "full-no-delete", "full"]
      },
      "Client": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "preset",
          "accounts",
          "sendEnabled",
          "status",
          "createdAt",
          "rotatedAt",
          "revokedAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "claude | chatgpt | cursor | vscode | muse | generic (free text)"
          },
          "preset": {
            "$ref": "#/components/schemas/Preset"
          },
          "accounts": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/components/schemas/ObjectId"
            },
            "description": "null = all mailboxes"
          },
          "sendEnabled": {
            "type": "boolean"
          },
          "status": {
            "enum": ["active", "revoked"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "rotatedAt": {
            "type": ["string", "null"]
          },
          "revokedAt": {
            "type": ["string", "null"]
          }
        }
      },
      "ClientCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "type": "string",
            "default": "generic"
          },
          "preset": {
            "$ref": "#/components/schemas/Preset",
            "default": "read-draft"
          },
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObjectId"
            }
          },
          "sendEnabled": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ClientPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "preset": {
            "$ref": "#/components/schemas/Preset"
          },
          "accounts": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/components/schemas/ObjectId"
            }
          },
          "sendEnabled": {
            "type": "boolean"
          }
        }
      },
      "ClientWithToken": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client", "token", "endpoint"],
        "properties": {
          "client": {
            "$ref": "#/components/schemas/Client"
          },
          "token": {
            "type": "string",
            "description": "Bearer token for the agent. Shown once; only its hash is stored."
          },
          "endpoint": {
            "type": "string",
            "description": "MCP endpoint URL for this tenant"
          }
        }
      },
      "AuditEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ts", "tenantId", "clientId", "tool", "result", "durationMs"],
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "tenantId": {
            "type": "string"
          },
          "clientId": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "mailbox": {
            "type": "string"
          },
          "uid": {
            "type": "integer"
          },
          "recipients": {
            "type": "integer"
          },
          "result": {
            "enum": ["ok", "denied", "error"]
          },
          "reason": {
            "type": "string"
          },
          "durationMs": {
            "type": "integer"
          }
        }
      },
      "AuditPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entries"],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "Usage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["today", "limit", "days"],
        "properties": {
          "today": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "days": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["total", "byClient"],
              "properties": {
                "total": {
                  "type": "integer"
                },
                "byClient": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
