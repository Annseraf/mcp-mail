{
  "openapi": "3.1.0",
  "info": {
    "title": "mcp-mail admin API",
    "version": "1.0.0",
    "description": "Private, service-token-authenticated API for driving a multi-tenant mcp-mail engine (MULTI_TENANT=true, ADMIN_API=true). Secrets are write-only: they can be set or replaced, never read back. Breaking changes ship as /admin/v2; v1 is kept for at least one major version.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3330/admin/v1"
    }
  ],
  "security": [
    {
      "serviceToken": []
    }
  ],
