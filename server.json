{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Annseraf/mcp-mail",
  "title": "mcp-mail",
  "description": "Self-hosted IMAP/SMTP email for any MCP client, with per-client permissions and audit log.",
  "repository": {
    "url": "https://github.com/Annseraf/mcp-mail",
    "source": "github"
  },
  "websiteUrl": "https://annseraf.github.io/mcp-mail/",
  "version": "1.2.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@annseraf/mcp-mail",
      "version": "1.2.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "stdio"
        }
      ],
      "environmentVariables": [
        {
          "name": "ACCOUNTS_FILE",
          "description": "Path to accounts.json (default ~/.config/mcp-mail/accounts.json)",
          "isRequired": false
        },
        {
          "name": "STDIO_PRESET",
          "description": "read-only | read-draft | organize | full-no-delete | full",
          "isRequired": false
        }
      ]
    }
  ]
}
